{
    "workflows": [
        {
            "name": "key gen",
            "steps": [
                {
                    "stepId": "key-gen-http",
                    "type": "scripted",
                    "trigger": {
                        "http": {
                            "method": "GET",
                            "server": "api",
                            "path": "/key-gen.*"
                        }
                    },
                    "resultsProcessor": {
                        "processors": [
                            {
                                "resource": "/httpserver/clear-headers.js"
                            },
                            {
                                "resource": "/httpserver/query-params-to-body.js",
                                "data": {
                                    "extract": [
                                        "purpose"
                                    ]
                                }
                            },
                            {
                                "resource": "/general/generate-key-pair.js"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
