{
    "workflows": [
        {
            "name": "packaged server bridge",
            "steps": [
                {
                    "stepId": "accept-forward-request",
                    "type": "scripted",
                    "trigger": {
                        "deploymentAccess": {
                            "ids": [
                                "bridge-callback"
                            ]
                        }
                    },
                    "urlGenerator": {
                        "resource": "/httpserver/forward-http-urlgenerator.js"
                    },
                    "payloadGenerator": {
                        "resource": "/httpserver/forward-http-payloadgenerator.js"
                    },
                    "resultsProcessor": {
                        "processors": [
                            {
                                "script": "const statusCode = parseInt(context.getProperty(\"status_code\") || \"200\", 10); context.setProperty(\"useResponse\", \"true\"); context.setBody(JSON.stringify({ statusCode, headers: { \"content-type\": \"application/json\" }, body: context.getBody() || \"\", isBase64Encoded: false }));"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
