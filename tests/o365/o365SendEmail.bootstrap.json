{
    "allowExternalHostAccess": [
        {
            "authenticationHost": true,
            "id": "login.microsoftonline.com",
            "host": "http://mockserver",
            "allowList": [
                {
                    "method": "POST",
                    "uriPattern": "/.*/oauth2/.*"
                }
            ],
            "data": {
                "o365SendEmailRefreshToken": "aRefreshToken",
                "o365SendEmailClientId": "aClientId"
            }
        },
        {
            "id": "graph.microsoft.com",
            "host": "http://mockserver",
            "allowList": [
                {
                    "method": "POST",
                    "uriPattern": "/v1.0/me/sendMail"
                }
            ]
        }
    ]
}
