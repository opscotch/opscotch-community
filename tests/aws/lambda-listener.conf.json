{
    "workflows" : [
        {
            "name" : "lambda listener",
            "steps" : [
                {
                    "stepId" : "lambda-listener-start",
                    "httpTimeout" : 0,
                    "comment" : "httpTimeout 0 is blocking forever",
                    "trigger" : {
                        "runOnce" : true
                    },
                    "urlGenerator" : {
                        "processors" : [
                            {
                                "comment" : "this is the earliest place to fast fail",
                                "script" : "if ( !context.getData('lambda-event-processor-deploymentId') || !context.getData('lambda-event-processor-stepId')) throw 'lambda-event-processor-deploymentId and lambda-event-processor-stepId must be data properties'"
                            },
                            {
                                "script" : "context.setUrl('aws-lambda-runtime-api', '/2018-06-01/runtime/invocation/next')"
                            }
                        ]
                    },  
                    "resultsProcessor" : {
                        "resource" : "aws/lambda-response-processor.js"
                    }
                },
                {
                    "stepId" : "lambda-listener-response",
                    "urlGenerator" : {
                        "script" : "context.setUrl('aws-lambda-runtime-api', `/2018-06-01/runtime/invocation/${context.getProperty('awsRequestId')}/${context.getProperty('responseType')}`)"
                    },
                    "payloadGenerator" : {
                        "processors" : [
                            {
                                "script" : "context.setHttpMethod('POST')"
                            }
                        ]
                    },
                    "resultsProcessor" : {
                        "script" : "//no"
                    }
                }

            ]
        },
        {
            "name" : "test responses",
            "steps" : [
                {
                    "stepId" : "_test_response_success_",
                    "resultsProcessor" : {
                        "script" : "context.setBody('success')"
                    }
                },
                {
                    "stepId" : "_test_response_failure_",
                    "resultsProcessor" : {
                        "script" : "context.setBody('failure'); context.addSystemError('it failed');"
                    }
                }
            ]
        }
    ]
}