{
    "allowExternalHostAccess": [
        {
            "id": "elastic",
            "host": "http://mockserver",
            "headers": {
                "Content-Type": "application/json;charset=UTF-8",
                "Accept": "application/json, text/plain, */*",
                "Authorization": "Basic abcd"
            },
            "allowList": [
                {
                    "method": "GET",
                    "uriPattern": "/_nodes/.*"
                }
            ],
            "data": {
                "authorization": "Basic LETMEIN"
            }
        }
    ]
}
