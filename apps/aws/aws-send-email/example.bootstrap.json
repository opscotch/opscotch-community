[
    {
        "deploymentId" : "email-sender",
        "remoteConfiguration" : "example.config.json",
        "allowHttpServerAccess": [
            {
                "id" : "email-sender",
                "port" : 9000
            }
        ],
        "allowDeploymentAccess" : [
            {
                "id" : "aws-services",
                "access" : "call",
                "deploymentId" : "aws-services"
            },
            {
                "id" : "aws-lambda-callback",
                "access" : "receive",
                "deploymentId" : "aws-services"
            }
        ],
        "data" : {
            "fromAddress" : "noreply@opscotch.co",
            "toAddress" : [ "jeremy.scott@opscotch.co", "glen.patrick@opscotch.co" ],
            "subject" : "New website contact",
            "responseMessage" : "Thank-you. Your message has been received."
        }
    },
    {
        "deploymentId" : "lambda",
        "remoteConfiguration" : "/home/jeremy/dev/opscotch/community/opscotch-community/apps/aws/aws-lambda/lambda.config.json",
        "allowExternalHostAccess": [
            {
                "id" : "aws-lambda-runtime-api",
                "host": "${AWS_LAMBDA_RUNTIME_API}"
            }
        ],
        "allowDeploymentAccess" : [
            {
                "id" : "aws-lambda-callback",
                "access" : "call",
                "deploymentId" : "email-sender"
            }
        ],
        "data" : {
            "lambdaEventCallback" : {
                "deploymentAccessId" : "aws-lambda-callback",
                "stepId" : "send-email"
            }
        }
    },
    {
        "deploymentId" : "aws-services",
        "packaging" : {
            "packageId" : "opscotch-aws-services"
        },
        "remoteConfiguration" : "/home/jeremy/dev/opscotch/community/opscotch-community/apps/aws/aws-services/aws-services.config.json",
        "allowExternalHostAccess": [
            {
                "id" : "sts",
                "host": "https://sts.amazonaws.com",
                "data" : {
                    "region": "us-east-1",
                    "host" : "sts.amazonaws.com",
                    "service" : "sts",
                    "accessKey" : "${AWS_ACCESS_KEY}",
                    "secretKey" : "${AWS_SECRET_KEY}"
                }
            },
            {
                "id": "ses",
                "host": "https://email.${AWS_REGION}.amazonaws.com",
                "data": {
                    "host": "email.${AWS_REGION}.amazonaws.com",
                    "service": "ses"
                }
            }
        ],
        "allowDeploymentAccess" : [
            {
                "id" : "callers",
                "access" : "receive",
                "anyDeployment" : true
            }
        ],
        "data" : {
            "awsRegion" : "${AWS_REGION}",
            "awsAccount" : "${AWS_ACCOUNT}",
            "awsRoleSessionName" : "awsOpscotchTest",
            "awsRoleArn" : "arn:aws:iam::${AWS_ACCOUNT}:role/opscotch-service"
        }
    }
]