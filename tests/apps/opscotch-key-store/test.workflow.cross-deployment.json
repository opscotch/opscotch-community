{
  "comment": "Cross-deployment key-store integration workflow.",
  "workflows": [
    {
      "name": "key-store cross-deployment integration test",
      "steps": [
        {
          "stepId": "accept-key-store",
          "trigger": {
            "deploymentAccess": {
              "ids": ["key-store-call"]
            }
          },
          "resultsProcessor": {
            "resource": "/accept-key-store.js"
          }
        },
        {
          "stepId": "key-store-get",
          "resultsProcessor": {
            "resource": "/key-store-operation.js"
          },
          "data": {
            "operation": "get"
          }
        },
        {
          "stepId": "key-store-get-or-generate",
          "resultsProcessor": {
            "resource": "/key-store-operation.js"
          },
          "data": {
            "operation": "getOrGenerate"
          }
        },
        {
          "stepId": "key-store-generate-key-pair",
          "resultsProcessor": {
            "resource": "/general/generate-key-pair.js"
          }
        },
        {
          "stepId": "test-storage",
          "resultsProcessor": {
            "resource": "/accept-storage.js"
          }
        },
        {
          "stepId": "storage-provider",
          "data": {
            "storageProvider": "memory"
          },
          "resultsProcessor": {
            "resource": "/storage-provider.js"
          }
        },
        {
          "stepId": "storage-provider-memory",
          "persistenceFile": "key-store-integration-memory.dat",
          "data": {
            "storageProvider": "memory"
          },
          "resultsProcessor": {
            "resource": "/memory-provider.js"
          }
        }
      ]
    }
  ]
}
