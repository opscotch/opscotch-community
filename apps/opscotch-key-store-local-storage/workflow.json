{
  "comment": "Deployment-access-only opaque record storage. No HTTP trigger or HTTP server is configured.",
  "workflows": [
    {
      "name": "opaque record storage API",
      "steps": [
        {
          "stepId": "accept-storage",
          "comment": "Accept storage operations only from the key-store deployment.",
          "trigger": {
            "deploymentAccess": {
              "ids": ["key-store-storage-call"]
            }
          },
          "resultsProcessor": {
            "resource": "/accept-storage.js"
          }
        },
        {
          "stepId": "storage-provider",
          "comment": "Provider-neutral storage seam. The initial provider is local-file.",
          "resultsProcessor": {
            "resource": "/storage-provider.js"
          },
          "data": {
            "storageProvider": "local-file"
          }
        },
        {
          "stepId": "storage-provider-local-file",
          "comment": "Production local-file provider implementation.",
          "resultsProcessor": {
            "resource": "/local-file-provider.js"
          },
          "data": {
            "storageProvider": "local-file"
          }
        },
        {
          "stepId": "storage-provider-memory",
          "comment": "Non-production provider used for contract tests only.",
          "persistenceFile": "memory-provider.dat",
          "resultsProcessor": {
            "resource": "/memory-provider.js"
          },
          "data": {
            "storageProvider": "memory"
          }
        }
      ]
    }
  ]
}
