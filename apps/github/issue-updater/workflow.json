{
  "comment": "Reusable GitHub issue updater app for labels, assignees, issue fields, and comments.",
  "defaultStepProperties": {
    "trigger": {
      "deploymentAccess": {
        "ids": [
          "github-issue-updater-callers",
          "github-issue-updater-callers-pr"
        ]
      }
    },
    "authenticationProcessor": {
      "resource": "/apps/github/github-auth-processor.js"
    },
    "urlGenerator": {
      "resource": "/apps/github/issues/update-url-generator.js"
    },
    "payloadGenerator": {
      "resource": "/apps/github/issues/update-payload-generator.js"
    },
    "resultsProcessor": {
      "resource": "/apps/github/issues/update-results-processor.js"
    },
    "httpStatusHandling": {
      "300-599": {
        "resource": "/apps/github/http-error.js",
        "data": {
          "httpErrorKind": "github-update"
        }
      }
    }
  },
  "workflows": [
    {
      "name": "github issue updater",
      "steps": [
        {
          "stepId": "github-issue-updater"
        },
        {
          "stepId": "github-issue-add-comment",
          "data": {
            "operation": "add-comment"
          }
        },
        {
          "stepId": "github-issue-update",
          "data": {
            "operation": "update-issue"
          }
        },
        {
          "stepId": "github-issue-delete-comment",
          "data": {
            "operation": "delete-comment"
          }
        },
        {
          "stepId": "github-pr-create",
          "data": {
            "operation": "create-pr"
          }
        },
        {
          "stepId": "github-pr-update",
          "data": {
            "operation": "update-pr"
          }
        },
        {
          "stepId": "github-pr-request-reviewers",
          "data": {
            "operation": "request-reviewers"
          }
        }
      ]
    }
  ]
}