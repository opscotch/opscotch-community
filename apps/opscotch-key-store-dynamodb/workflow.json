{
  "comment": "Deployment-access-only opaque record storage backed by DynamoDB through opscotch-aws-services.",
  "workflows": [
    {
      "name": "opaque DynamoDB record storage API",
      "steps": [
        {
          "stepId": "storage-provider",
          "trigger": { "deploymentAccess": { "ids": ["key-store-storage-call"] } },
          "resultsProcessor": { "resource": "/apps/ospcotch-key-store-dynamodb/dynamodb-storage-provider.js" }
        },
        {
          "stepId": "table-check",
          "resultsProcessor": { "resource": "/apps/aws/dynamodb/create-table-if-not-exists.js" },
          "persistenceFile": "table-check",
          "data": {
            "tableSchema": {
              "AttributeDefinitions": [
                { "AttributeName": "recordId", "AttributeType": "S" }
              ],
              "KeySchema": [
                { "AttributeName": "recordId", "KeyType": "HASH" }
              ],
              "BillingMode": "PAY_PER_REQUEST"
            }
          }
        },
        {
          "stepId": "storage-provider-dynamodb",
          "resultsProcessor": { "resource": "/apps/ospcotch-key-store-dynamodb/dynamodb-provider.js" }
        }
      ]
    }
  ]
}
