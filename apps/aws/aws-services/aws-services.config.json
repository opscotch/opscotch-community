        {
            "name" : "SQS specifc url",
            "steps" : [
                {
                    "stepId" : "sqs-request",
                    "debug" : true,
                    "trigger" : {
                        "deploymentAccess" : {
                            "ids" : [
                                "callers" 
                            ]
                        }
                    },
                    "authenticationProcessor" : {
                        "processors" : [
                            {
                                "script" : "context.sendToStep(`get-cached-tokens`, ``)"
                            },
                            {
                                "resource" : "apps/aws/authentication/sigv4.js"
                            }
                        ]
                    },
                    "urlGenerator" : {
                        "resource" : "apps/aws/sqs-urlgenerator.js"
                    },
                    "payloadGenerator" : {
                        "resource" : "apps/aws/query-api-payloadgenerator.js"
                    },
                    "httpStatusHandling": {
                        "0-399" : {
                            "script" : "context.setBody(context.xmlToJson(context.getBody())); context.setProperty(`status_code`, 200)" 
                        },
                        "400" : {
                            "script" : "context.setBody(JSON.stringify(JSON.parse(context.xmlToJson(context.getBody())).ErrorResponse)); context.setProperty(`status_code`, 400);"
                        },
                        "401-599" : {
                            "script" : "context.setBody(JSON.stringify(JSON.parse(context.xmlToJson(context.getBody())).ErrorResponse)); context.setProperty(`status_code`, 500);"
                        }
                    },
                    "data" : {
                        "aws_query_api_version" : "2012-11-05",
                        "hostId" : "sqs"
                    }
                }
            ]
        },
