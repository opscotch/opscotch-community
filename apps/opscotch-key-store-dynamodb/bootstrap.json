[
  {
    "deploymentId": "opscotch-key-store-dynamodb",
    "remoteConfiguration": "workflow.json",
    "persistenceRoot": "./data",
    "frequency": 0,
    "startupPriority": 10,
    "allowDeploymentAccess": [
      {
        "id": "key-store-storage-call",
        "deploymentId": "opscotch-key-store",
        "access": "receive"
      },
      {
        "id": "aws-services",
        "deploymentId": "aws-services",
        "access": "call"
      }
    ],
    "data": {
      "tableName": "OpscotchKeyStore",
      "keyField": "recordId",
      "awsServicesId": "aws-services",
      "enableTTL": false
    }
  },
  {
    "deferLoading": "true",
    "deploymentId": "aws-services",
    "packaging": {
      "packageId": "opscotch-aws-services",
      "packagerIdentities": ["opscotch-aws-services-identity"],
      "requiredSigners": [
        {
          "id": "opscotch-aws-services-1.x",
          "description": "Opscotch AWS Services App version 1.x lock"
        }
      ]
    },
    "keys": [
      {
        "id": "opscotch-app",
        "purpose": "sign",
        "type": "public",
        "keyHex": "8C9AED01FF5E6695E4464E754697F22D653A9FB35E1233627D81D91F89CF2874"
      },
      {
        "id": "opscotch-aws-services-app",
        "purpose": "sign",
        "type": "public",
        "keyHex": "03DBDC90F71E53AA84CD4FAA8BC8E5025743E55385C4163EE92B2FFA33EBA457"
      },
      {
        "id": "opscotch-aws-services-1.x",
        "purpose": "sign",
        "type": "public",
        "keyHex": "2C2698E5C868257C58A6B1D6D2D81388403FA0ED1A159068EEFB0F4DF87A3535"
      },
      {
        "id": "opscotch-aws-services-identiy",
        "purpose": "authenticated",
        "type": "public",
        "keyHex": "673FDE8F1CAADA35D2D8D8A927CE9C3108A7A7943776BEB1CB19207BAA20A515"
      }
    ],
    "remoteConfiguration": "/apps/opscotch-aws-services.oapp",
    "frequency": 0,
    "remoteConfigurationTimeout": 10000,
    "allowExternalHostAccess": [
      {
        "id": "sts",
        "host": "https://sts.amazonaws.com",
        "data": {
          "region": "us-east-1",
          "host": "sts.amazonaws.com",
          "service": "sts",
          "accessKey": "${AWS_ACCESS_KEY_ID}",
          "secretKey": "${AWS_SECRET_ACCESS_KEY}",
          "amzSecurityToken": "${AWS_SESSION_TOKEN:}"
        }
      },
      {
        "id": "dynamodb",
        "host": "https://dynamodb.${AWS_REGION}.amazonaws.com",
        "data": {
          "host": "dynamodb.${AWS_REGION}.amazonaws.com",
          "service": "dynamodb"
        }
      }
    ],
    "allowDeploymentAccess": [
      {
        "id": "callers",
        "access": "receive",
        "deploymentId": "opscotch-key-store-dynamodb"
      }
    ],
    "data": {
      "awsRegion": "${AWS_REGION}",
      "awsAccount": "${AWS_ACCOUNT}"
    }
  }
]
