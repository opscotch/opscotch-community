{
    "workflows" : [
        {
            "name" : "auth testing",
            "steps" : [
                {
                    "stepId" : "set-auth-headers-direct",
                    "authenticationProcessor" : {
                        "processors" : [
                            {
                                "comment" : "load the direct-call secret in the auth-only context",
                                "script" : "var d = JSON.parse(context.getRestrictedDataFromHost('protected-host')); context.setHeader('Authorization', d.directAuthHeader); console.log(`auth console.log: ${d.directAuthHeader}`); context.diagnosticLog(`auth diagnosticLog: ${d.directAuthHeader}`);"
                            }
                        ]
                    },
                    "urlGenerator" : {
                        "script" : "context.setUrl('call-host', '');"
                    },
                    "resultsProcessor" : {
                        "processors" : [
                            {
                                "comment" : "exfiltrate via header",
                                "script" : "console.log(`do I have the secret: ${context.getHeader('Authorization')}`)"
                            },
                            {
                                "comment" : "attempt to leak the secret via logs",
                                "script" : "console.log('what if I did steal it, is it redacted?')"
                            },
                            {
                                "comment" : "attempt to leak the secret via metric name and dimensions",
                                "script" : "context.sendMetric(0, 'notExfiltrated', 1.0, { 'key' : 'value' })"
                            },
                            {
                                "script" : "context.sendMetric('done', 1.0)"
                            }
                        ]
                    }
                },
                {
                    "stepId" : "set-auth-headers-indirect",
                    "authenticationProcessor" : {
                        "processors" : [
                            {
                                "comment" : "load the indirect-call secret, then forward only to another auth step",
                                "script" : "var d = JSON.parse(context.getRestrictedDataFromHost('protected-host')); context.setHeader('Authorization', d.indirectAuthHeader); context.sendToStep('set-auth-headers-indirect-auth-step', '');"
                            }
                        ]
                    },
                    "urlGenerator" : {
                        "script" : "context.setUrl('call-host', '');"
                    },
                    "resultsProcessor" : {
                        "processors" : [
                            {
                                "comment" : "normal result processing must not be able to read auth-only headers",
                                "script" : "console.log(`do I have the secret: ${context.getHeader('Authorization')}`)"
                            },
                            {
                                "comment" : "attempt to leak via logs after the auth-only hop",
                                "script" : "console.log('what if I did steal it, is it redacted?')"
                            },
                            {
                                "comment" : "repeat the header check to keep the fixture explicit",
                                "script" : "console.log(`do I have the secret: ${context.getHeader('Authorization')}`)"
                            },
                            {
                                "comment" : "repeat the log check after the auth-only hop",
                                "script" : "console.log('what if I did steal it, is it redacted?')"
                            },
                            {
                                "comment" : "attempt to leak via metric name",
                                "script" : "context.sendMetric('notExfiltrated', 1.0)"
                            },
                            {
                                "script" : "context.sendMetric('done', 1.0)"
                            }
                        ]
                    }
                },
                {
                    "stepId" : "set-auth-headers-indirect-auth-step",
                    "type" : "scripted-auth",
                    "resultsProcessor" : {
                        "processors" : [
                            {
                                "comment" : "the forwarded auth step still cannot read the auth header through normal JS APIs",
                                "script" : "console.log(`do I have the secret: ${context.getHeader('Authorization')}`)"
                            },
                            {
                                "comment" : "attempt to leak via logs inside the auth-only helper",
                                "script" : "console.log('what if I did steal it, is it redacted?')"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
