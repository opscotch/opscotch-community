{
    "allowExternalHostAccess": [
        {
            "id": "jira",
            "host": "http://mockserver",
            "headers": {
                "Content-Type": "application/json;charset=UTF-8",
                "Accept": "application/json, text/plain, */*"
            },
            "allowList": [
                {
                    "method": "POST",
                    "uriPattern": "/rest/api/2/issue/.*"
                }
            ],
            "data": {
                "authorization": "Basic base64(user@abc.co:token)"
            }
        }
    ]
}
