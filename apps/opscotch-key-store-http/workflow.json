{
  "comment": "HTTP adapter for the deployment-access-only key store.",
  "workflows": [
    {
      "name": "key store HTTP API",
      "comment": "Forward HTTP request bodies to the authorized key-store deployment.",
      "steps": [
        {
          "stepId": "health",
          "comment": "Unauthenticated liveness endpoint for the HTTP adapter.",
          "type": "scripted",
          "trigger": {
            "http": {
              "method": "GET",
              "server": "api",
              "path": "/health"
            }
          },
          "resultsProcessor": {
            "processors": [
              {
                "resource": "/httpserver/clear-headers.js"
              },
              {
                "script": "context.setProperty(\"status_code\", \"200\"); context.setHeader(\"content-type\", \"application/json\"); context.setBody(JSON.stringify({ status: \"ok\" }));"
              }
            ]
          }
        },
        {
          "stepId": "accept-key-store-http",
          "comment": "HTTP entry point for get, put, and getOrGenerate requests.",
          "trigger": {
            "http": {
              "method": "POST",
              "server": "api",
              "path": "/key-store"
            }
          },
          "resultsProcessor": {
            "resource": "/apps/ospcotch-key-store/accept-key-store-http.js"
          }
        }
      ]
    }
  ]
}
