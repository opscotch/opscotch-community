[
  {
    "deploymentId": "tcp-example",
    "remoteConfiguration": "tcp.config.json",
    "allowHttpServerAccess": [
      {
          "id" : "tcp-listener",
          "port" : 13000,
          "tcp" : true
      }
    ],
    "workflow" : {
      "outputs" : [
        {
          "enabled" : true,
          "id" : "my-otel",
          "routingToken" : "my-otel",
          "outputUrl": "http://localhost:4317",
          "type": "otel",
          "typeProperties": {
            "otel": {
              "protocol": "grpc"
            }
          }
        }
      ]
    }
  }
]